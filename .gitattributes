# Chuẩn hoá xuống dòng: mọi file text lưu LF trong repo (blob), tránh việc build script
# / GitHub Action (chạy Linux) và máy Windows liên tục "đá" nhau về CRLF.
* text=auto eol=lf

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf

# Nhị phân - không đụng vào
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.mp4   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
