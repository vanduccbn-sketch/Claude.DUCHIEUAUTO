# Copy file này thành .env (không commit .env thật lên git) rồi điền giá trị thật.

# Cổng server lắng nghe (Render sẽ tự set biến PORT, để trống là được khi deploy)
PORT=4000

# Chuỗi bí mật ký JWT - PHẢI đổi sang giá trị ngẫu nhiên dài, không dùng giá trị mẫu này khi deploy thật
JWT_SECRET=doi-chuoi-nay-truoc-khi-deploy-that

# Domain frontend được phép gọi API (CORS) - domain thật qua Cloudflare (2026-07-27)
# (localhost/127.0.0.1 luôn được cho phép thêm để test local, xem server.js)
FRONTEND_ORIGIN=https://duchieuauto.vn

# Turso (libSQL) - tạo database free tại app.turso.tech (không cần thẻ tín dụng), lấy URL + token
# ở mục "Connect" của database
TURSO_DATABASE_URL=libsql://ten-database-cua-ban.turso.io
TURSO_AUTH_TOKEN=dan-token-that-vao-day

# Cloudinary (free tier, không cần thẻ tín dụng) - lưu ảnh upload (bìa bài viết, banner, ảnh sản
# phẩm) qua CDN thay vì ổ đĩa Render (không persistent). Lấy 3 giá trị này ở Dashboard sau khi
# đăng ký tại cloudinary.com.
CLOUDINARY_CLOUD_NAME=dan-cloud-name-that
CLOUDINARY_API_KEY=dan-api-key-that
CLOUDINARY_API_SECRET=dan-api-secret-that

# Phase 10 - nhận lead từ Facebook Lead Ads (routes/leads.js), để trống nếu chưa dùng tính năng
# này - webhook chỉ đơn giản không hoạt động khi thiếu, không ảnh hưởng gì phần còn lại.
# FB_VERIFY_TOKEN: 1 chuỗi bí mật TỰ NGHĨ RA (không lấy từ Facebook) - gõ trùng giá trị này vào ô
# "Verify Token" lúc đăng ký webhook trên Facebook App Dashboard.
FB_VERIFY_TOKEN=tu-nghi-1-chuoi-bi-mat-rieng
# FB_APP_SECRET: lấy ở Facebook App Dashboard -> Settings -> Basic -> App Secret.
FB_APP_SECRET=dan-app-secret-that
# FB_PAGE_ACCESS_TOKEN: Page Access Token của đúng Fanpage chạy quảng cáo Lead Ads (lấy qua Graph
# API Explorer hoặc System User trong Business Manager - cần quyền leads_retrieval).
FB_PAGE_ACCESS_TOKEN=dan-page-access-token-that

# Phase 10 - nhận lead từ TikTok Lead Ads, tương tự Facebook (verify token tự nghĩ ra).
TIKTOK_VERIFY_TOKEN=tu-nghi-1-chuoi-bi-mat-rieng-khac

# reCAPTCHA v2 (checkbox) cho form liên hệ/đặt lịch/nhắc bảo dưỡng/đánh giá - tạo tại
# google.com/recaptcha/admin. Site key (công khai) đặt trực tiếp trong HTML từng trang, CHỈ
# secret key này cần giữ bí mật ở server. Để trống nếu chưa cấu hình - form vẫn hoạt động bình
# thường, chỉ là chưa được reCAPTCHA bảo vệ (xem utils/verify-recaptcha.js).
RECAPTCHA_SECRET_KEY=dan-secret-key-that

# Gửi email "quên mật khẩu" qua Resend (resend.com) - domain duchieuauto.vn đã verify. Lấy API key
# ở Resend Dashboard -> API Keys. Để trống nếu chưa cấu hình - admin vẫn login/đổi mật khẩu bình
# thường, chỉ là chưa dùng được nút "Quên mật khẩu" (xem utils/mailer.js).
RESEND_API_KEY=dan-resend-api-key-that
# Domain admin panel thật, dùng để build link trong email đặt lại mật khẩu. Đổi thành
# https://admin.duchieuauto.vn khi deploy lên Render.
ADMIN_BASE_URL=http://localhost:4000
